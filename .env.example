# Copy to .env; generate local secrets with scripts/start.ps1.
MF_PG_DATABASE=modelforge
MF_PG_USER=modelforge
MF_PG_PASSWORD=replace-with-random-local-secret
MF_MINIO_ACCESS_KEY=modelforge-local
MF_MINIO_SECRET_KEY=replace-with-random-local-secret
MF_MINIO_BUCKET=modelforge
# Read inactivity budget for object transfers and multipart completion, not health probes.
MF_MINIO_READ_TIMEOUT=120
MF_WEB_PORT=8092
MF_API_PORT=8102

# Container-only DNS for external provider APIs. Leave the host/Windows DNS
# untouched; these values are applied only to backend containers.
MF_DNS_PRIMARY=223.5.5.5
MF_DNS_SECONDARY=119.29.29.29

# Initial model-directory transfer limits; not a measured capacity guarantee.
MF_MODEL_FILE_LIMIT_BYTES=21474836480
MF_MODEL_TOTAL_LIMIT_BYTES=107374182400
MF_MODEL_FILE_COUNT_LIMIT=10000
MF_MODEL_LIMITS_LOCKED=false
# Compose persists partial public-model downloads in ./.runtime/model-imports.
# MF_MODEL_TEMPORARY_DIRECTORY=/tmp/modelforge-models

# Optional MinIO source-build proxy; official default remains unchanged.
# MF_GOPROXY=https://goproxy.cn,direct

# CompShare credentials. When both keys are configured, compute writes and
# managed training are enabled; there is no separate write toggle.
# MF_UCLOUD_PUBLIC_KEY=
# MF_UCLOUD_PRIVATE_KEY=
# MF_UCLOUD_PROJECT_ID=
# MF_UCLOUD_REGION=
# MF_UCLOUD_API_URL=https://api.compshare.cn
# MF_UCLOUD_TIMEOUT=20

# Remote channel: server-owned file mounted read-only; never send keys via browser.
MF_SSH_ENDPOINTS_FILE=/run/modelforge/ssh/endpoints.json
MF_SSH_TRANSFER_TIMEOUT=1800

# AI diagnosis is disabled by default. Set a model, an OpenAI-compatible
# endpoint, and an API key only after the dependency smoke test is approved.
MF_AI_ENABLED=false
# MF_AI_MODEL=
# MF_AI_BASE_URL=
# MF_AI_API_KEY=
MF_AI_STRUCTURED_OUTPUT_METHOD=json_schema
MF_AI_TIMEOUT_SECONDS=25
# MF_AI_CHECKPOINT_DSN=postgresql://modelforge_checkpoint:secret@postgres/modelforge
MF_AI_CHECKPOINT_SCHEMA=langgraph_checkpoint
MF_AI_CHECKPOINT_TTL_HOURS=24
MF_AI_WORKER_POLL_SECONDS=2
MF_AI_MAX_ATTEMPTS=3
MF_AI_LEASE_SECONDS=90
